expression_statement: assignment LINE_TERM
assignment: IDENTIFIER OP_ASSIGN expression
expression: comparison

# arithmetic
comparison: factor (OP_LT | OP_GT | OP_LTE | OP_GTE | OP_EQ | OP_NEQ) factor
factor: term (OP_PLUS | OP_MINUS) factor | term
term: unary (OP_DIV | OP_MULT) term | unary
unary: OP_MINUS? primary

# building blocks for expressions

basic: LITERAL | IDENTIFIER | LEFT_BRACE expression RIGHT_BRACE | func_call
func_call: IDENTIFIER LEFT_BRACE (expression ",")* RIGHT_BRACE
type_definition: IDENTIFIER COLON STATIC_TYPE | basic
