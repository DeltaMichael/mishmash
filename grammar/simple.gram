# func_def: func_sig declr_block
# func_sig: FUNC IDENFITIFER LEFT_BRACE (type_definition DELIMITER)* RIGHT_BRACE (COLON STATIC_TYPE)?
# declr_block: DECLR (var_declr LINE_TERM)* block
# block: BEGIN (line)+ END
line: assignment LINE_TERM;
assignment: IDENTIFIER OP_ASSIGN expression | expression;
expression: comparison;

# arithmetic
comparison: factor (OP_LT OP_GT OP_LTE OP_GTE OP_EQ OP_NEQ)$ factor | factor;
factor: term (OP_PLUS OP_MINUS)$ factor | term;
term: unary (OP_DIV OP_MULT)$ term | unary;

# building blocks for expressions
unary: OP_MINUS basic | basic;
var_declr: IDENTIFIER COLON STATIC_TYPE;
# func_call: IDENTIFIER LEFT_BRACE (expression COMMA)* RIGHT_BRACE | NULL;
basic: LEFT_BRACE expression RIGHT_BRACE | func_call | IDENTIFIER | LITERAL;
# basic: IDENTIFIER | LITERAL | func_call;
